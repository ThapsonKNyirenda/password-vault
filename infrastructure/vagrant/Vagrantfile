Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  nodes = {
    "vault" => { ip: "192.168.56.10", memory: 4096 },
    "agent" => { ip: "192.168.56.11", memory: 3072 },
    "target-unix" => { ip: "192.168.56.12", memory: 2048 }
  }

  nodes.each do |name, opts|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: opts[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name = "vault-lab-#{name}"
        vb.memory = opts[:memory]
        vb.cpus = 2
      end

      node.vm.provision "shell", inline: <<-SHELL
        set -e
        apt-get update -y
        apt-get install -y curl git
      SHELL

      if name == "vault" || name == "agent"
        node.vm.provision "shell", inline: <<-SHELL
          set -e
          apt-get install -y docker.io docker-compose-plugin
          usermod -aG docker vagrant
          systemctl enable docker
          systemctl start docker
        SHELL
      end

      if name == "target-unix"
        node.vm.provision "shell", inline: <<-SHELL
          set -e
          apt-get install -y openssh-server sudo
          systemctl enable ssh
          systemctl start ssh

          id -u opsadmin >/dev/null 2>&1 || useradd -m -s /bin/bash opsadmin
          id -u svc_app >/dev/null 2>&1 || useradd -m -s /bin/bash svc_app

          echo 'opsadmin ALL=(ALL) NOPASSWD: /usr/sbin/chpasswd' >/etc/sudoers.d/opsadmin-chpasswd
          chmod 440 /etc/sudoers.d/opsadmin-chpasswd

          mkdir -p /home/opsadmin/.ssh
          chmod 700 /home/opsadmin/.ssh

          if [ -f /vagrant/../../keys/id_ed25519.pub ]; then
            cat /vagrant/../../keys/id_ed25519.pub >/home/opsadmin/.ssh/authorized_keys
            chmod 600 /home/opsadmin/.ssh/authorized_keys
            chown -R opsadmin:opsadmin /home/opsadmin/.ssh
          fi
        SHELL
      end
    end
  end
end
